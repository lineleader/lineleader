# Paste this site block into the Caddy config on the `traefik` tailnet node
# (100.105.59.51). Caddy handles TLS automatically via ACME for this
# domain — no cert config needed here.
#
# 100.119.145.113 is percival's Tailscale IP, where the lineleader
# container publishes port 8080 (see deploy/percival/docker-compose.yml).
# This node reaches percival over Tailscale, not the public internet.
#
# DNS prerequisite: lineleader.io must have an A record pointing at this
# node's PUBLIC IP, 34.29.51.143, DNS-only (grey cloud) in Cloudflare —
# the same pattern rss.c18l.com already uses. Caddy's ACME challenge fails
# until that record resolves.

lineleader.io {
    reverse_proxy 100.119.145.113:8080
}

# Optional variant: have Caddy actively health-check the upstream via
# GET /healthz (the unauthenticated health endpoint — see
# internal/web/server.go) instead of just reacting to failed proxied
# requests. Uncomment to use it in place of the block above:
#
# lineleader.io {
#     reverse_proxy 100.119.145.113:8080 {
#         health_uri /healthz
#     }
# }
